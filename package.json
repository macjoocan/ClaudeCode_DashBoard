{
  "name": "cc-launcher",
  "version": "2.0.0",
  "private": true,
  "description": "Claude Code와 OpenAI Codex 세션을 한 화면에서 관리하는 로컬 대시보드",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build:docs": "esbuild docs-client.js --bundle --minify --format=iife --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=docs-assets/[name]-[hash] --outfile=public/docs.bundle.js"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
